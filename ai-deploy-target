def ssh_client_ip():
    """The connecting client's IP from SSH_CLIENT, or None when not over SSH."""
    value = (os.environ.get("SSH_CLIENT") or "").strip()
    if not value:
        return None
    return value.split()[0]


def ai_ops_ssh_dir(runner):
    return os.path.join(runner.target(AI_OPS_HOME), ".ssh")


def ai_ops_authorized_keys_path(runner):
    return os.path.join(ai_ops_ssh_dir(runner), "authorized_keys")


def parse_ai_ops_sources(value):
    """Validate a comma-separated list of IPv4/IPv6 addresses or CIDRs (max 8).

    Returns the tokens in order; an empty value means "any source".
    """
    text = (value or "").strip()
    if not text:
        return []
    parts = [part.strip() for part in text.split(",")]
    parts = [part for part in parts if part]
    if len(parts) > AI_OPS_MAX_SOURCES:
        raise Fail(f"--from accepts at most {AI_OPS_MAX_SOURCES} addresses/CIDRs "
                   f"(got {len(parts)})", 2)
    for part in parts:
        try:
            ipaddress.ip_network(part, strict=False)
        except ValueError:
            raise Fail(f"invalid --from address or CIDR {part!r} "
                       f"(use e.g. 203.0.113.5 or 10.0.0.0/8)", 2)
    return parts


def ai_ops_managed_key_line(key_type, blob, sources):
    options = []
    if sources:
        options.append('from="' + ",".join(sources) + '"')
    options += ["no-port-forwarding", "no-agent-forwarding", "no-X11-forwarding"]
    return ",".join(options) + f" {key_type} {blob} {AI_OPS_USER}"


def say_any_source_warning():
    say(f"WARNING: the {AI_OPS_USER} key is accepted from ANY source; restrict it with "
        f"`--from <CIDR>` (e.g. the VM's IP) so a stolen key alone is not enough from anywhere")


def ensure_ai_ops_user(runner):
    home = runner.target(AI_OPS_HOME)
    if user_exists(runner, AI_OPS_USER):
        info = getent_passwd(runner, AI_OPS_USER) or {}
        if info.get("shell") != "/bin/bash":
            runner.mutate("usermod", "--shell", "/bin/bash", AI_OPS_USER)
        else:
            say(f"user {AI_OPS_USER} exists")
    else:
        runner.mutate("useradd", "--system", "--create-home", "--home-dir", AI_OPS_HOME,
                      "--shell", "/bin/bash", AI_OPS_USER)
    runner.mutate("passwd", "-l", AI_OPS_USER)
    ensure_dir(runner, home, 0o700, owner=f"{AI_OPS_USER}:{AI_OPS_USER}")


def write_ai_ops_authorized_keys(runner, key_type, blob, sources):
    ssh_dir = ai_ops_ssh_dir(runner)
    # sshd reads authorized_keys as ai-ops: the 0700 .ssh dir and the 0600 file must both
    # belong to ai-ops (the same bug that once made sshd refuse the deploy user's key).
    ensure_dir(runner, ssh_dir, 0o700, owner=f"{AI_OPS_USER}:{AI_OPS_USER}")
    write_file(runner, ai_ops_authorized_keys_path(runner),
               ai_ops_managed_key_line(key_type, blob, sources) + "\n", 0o600,
               owner=f"{AI_OPS_USER}:{AI_OPS_USER}")


def ai_ops_sudoers_content():
    header = (f"# Managed by {PROG}: TOTP-gated AI admin access (revoke with "
              f"`{PROG} ai-ops disable`). Do not edit by hand.\n")
    return header + f"{AI_OPS_USER} ALL=(ALL:ALL) NOPASSWD: ALL\n"


def install_ai_ops_sudoers(runner):
    path = runner.target(AI_OPS_SUDOERS_PATH)
    content = ai_ops_sudoers_content()
    if runner.check:
        plan(f"write {path} (mode 440) with:")
        say(f"    {AI_OPS_USER} ALL=(ALL:ALL) NOPASSWD: ALL")
        return
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    handle, tmp = tempfile.mkstemp(prefix=".ai-ops.sudoers.", dir=directory)
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        stream.write(content)
    os.chmod(tmp, 0o440)
    visudo = runner.which("visudo")
    if visudo is None:
        os.unlink(tmp)
        raise Fail("visudo is not available" + runner.install_hint(("sudo",)))
    proc = runner.run("visudo", "-cf", tmp)
    if not proc.ok:
        os.unlink(tmp)
        detail = (proc.err or proc.out).strip()
        raise Fail(f"visudo rejected the generated sudoers file: {detail or 'exit %d' % proc.rc}")
    os.replace(tmp, path)
    os.chmod(path, 0o440)
    say(f"wrote: {path} (mode 440)")
    say(f"    {AI_OPS_USER} ALL=(ALL:ALL) NOPASSWD: ALL")


def handle_selinux_ai_ops(runner):
    if not runner.have("getenforce"):
        return
    mode = runner.run("getenforce").out.strip()
    if mode not in ("Enforcing", "Permissive"):
        return
    pattern = r"/var/lib/ai-ops/\.ssh(/.*)?"
    if not runner.have("semanage"):
        say("warning: semanage is not available; install policycoreutils-python-utils and re-run")
        return
    added = runner.mutate("semanage", "fcontext", "-a", "-t", "ssh_home_t", pattern,
                          ignore_failure=True)
    if not added.ok and not runner.check:
        runner.mutate("semanage", "fcontext", "-m", "-t", "ssh_home_t", pattern,
                      ignore_failure=True)
    runner.mutate("restorecon", "-R", runner.target(AI_OPS_HOME), ignore_failure=True)


def enable_ai_ops(runner, key_line, source_value):
    """Validate and install AI ops access, changing nothing when the input is invalid."""
    key_type, blob = validate_public_key(runner, key_line)
    sources = parse_ai_ops_sources(source_value)
    # visudo-check the sudoers rule first: a bad rule then leaves no user, no key and no rule.
    install_ai_ops_sudoers(runner)
    ensure_ai_ops_user(runner)
    write_ai_ops_authorized_keys(runner, key_type, blob, sources)
    handle_selinux_ai_ops(runner)
    return key_type, blob, sources


def report_ai_ops_enabled(sources):
    say(f"AI ops access enabled: {AI_OPS_USER} may log in with the AI ops key"
        + (f" from {', '.join(sources)}" if sources else " from any source"))
    say(f"on the VM: grant with `ai-remote admin grant <machine>` (60 min); revoke on the target "
        f"with `{PROG} ai-ops disable`")


def setup_ai_ops(runner, args):
    key_line = args.ai_ops_key
    if key_line is None:
        if runner.yes:
            say("no --ai-ops-key given: TOTP-gated AI admin access not configured")
            return
        key_line = ask(runner, "Paste the AI ops public key (ssh-ed25519 ...), or press Enter to skip",
                       default="", required=False)
        if not key_line:
            say("skipped: TOTP-gated AI admin access not configured")
            return
    source_value = args.ai_ops_from
    if source_value is None:
        default_source = ssh_client_ip() or ""
        if runner.yes:
            source_value = default_source
        else:
            source_value = ask(runner,
                               "Restrict the AI ops key to source address/CIDR(s) "
                               "(comma-separated, max 8), or Enter for any source",
                               default=default_source or None, required=False) or ""
    _, _, sources = enable_ai_ops(runner, key_line, source_value)
    if not sources:
        say_any_source_warning()
    report_ai_ops_enabled(sources)


def cmd_ai_ops_enable(runner, args):
    require_root(runner)
    runner.os_info = detect_os(runner)
    key_line = args.key
    if not key_line:
        key_line = ask(runner, "Paste the AI ops public key (ssh-ed25519 ...)", required=True)
    _, _, sources = enable_ai_ops(runner, key_line, args.source)
    if not sources:
        say_any_source_warning()
    report_ai_ops_enabled(sources)
    return 0


def cmd_ai_ops_disable(runner, args):
