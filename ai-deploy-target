def http_health(url, timeout=3.0):
    try:
        request = urllib.request.Request(url, headers={"User-Agent": PROG, "Accept": "*/*"})
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return 200 <= response.status < 300, f"HTTP {response.status}"
    except urllib.error.HTTPError as exc:
        return False, f"HTTP {exc.code}"
    except Exception as exc:  # noqa: BLE001 - doctor must never crash
        return False, f"{type(exc).__name__}: {exc}"


def parse_sshd_allow(output):
    """Return (AllowUsers, AllowGroups) from `sshd -T` output."""
    allow_users = []
    allow_groups = []
    for raw in output.splitlines():
        key, _, value = raw.strip().partition(" ")
        key = key.lower()
        if key == "allowusers":
            allow_users = value.split()
        elif key == "allowgroups":
            allow_groups = value.split()
    return allow_users, allow_groups


def sshd_allow_excludes(runner, account, allow_users, allow_groups):
    """A message when sshd AllowUsers/AllowGroups would lock `account` out, else None."""
    def allowed(patterns):
        for pattern in patterns:
            pattern = pattern.split("@", 1)[0]
            if pattern == account or fnmatch.fnmatch(account, pattern):
                return True
        return False

    if allow_users and not allowed(allow_users):
        return f"sshd AllowUsers ({' '.join(allow_users)}) excludes {account}"
    if allow_groups and not any(user_in_group(runner, account, group) for group in allow_groups):
        return f"sshd AllowGroups ({' '.join(allow_groups)}) excludes {account}"
    return None


def cmd_doctor(runner, args):
    runner.os_info = detect_os(runner)
    failures = 0

    def report(ok, message, warning=False):
        nonlocal failures
        if ok:
            say("ok:   " + message)
        elif warning:
            say("warn: " + message)
        else:
            say("fail: " + message)
            failures += 1

    say(f"{PROG} {package_version()} doctor")
    document = load_document(runner)
    report(document is not None, f"{runner.target(CONFIG_PATH)} present")
    if document is None:
        say(f"doctor: {failures} problem(s)")
        return 1
    report(user_exists(runner, DEPLOY_USER), f"user {DEPLOY_USER} exists")

    auth_path = deploy_authorized_keys_path(runner)
    content = read_file(auth_path)
    if content is None:
        report(False, f"{auth_path} present")
    else:
        lines = [line for line in content.splitlines() if line.strip()]
        prefix = 'restrict,command="' + gateway_command(runner) + '"'
        bad = [line for line in lines if not line.startswith(prefix)]
        report(not bad, f"{auth_path} contains only managed forced-command lines")
        report(bool(lines), f"{auth_path} has at least one key")
    if not runner.test_mode:
        import pwd
        try:
            uid = pwd.getpwnam(DEPLOY_USER).pw_uid
        except KeyError:
            uid = None
        for path in (runner.target(DEPLOY_HOME), os.path.dirname(auth_path), auth_path):
            if uid is not None and os.path.exists(path):
                owner = os.stat(path).st_uid
                report(owner == uid, f"{path} owned by {DEPLOY_USER} (sshd refuses the key otherwise)")

    gateway_file = runner.target(GATEWAY_PATH)
    report(os.path.exists(gateway_file), f"gateway installed at {gateway_file}")
    version_file = runner.target(INSTALLED_VERSION_PATH)
    installed = read_file(version_file, "").strip() if os.path.exists(version_file) else ""
    report(bool(installed), f"installed version {installed or 'missing'}")
    for path, expected in ((gateway_file, 0o755), (version_file, 0o644)):
        if os.path.exists(path):
            actual = stat.S_IMODE(os.stat(path).st_mode)
            report(actual == expected, f"{path} mode {actual:o} (want {expected:o})")
    home = runner.target(DEPLOY_HOME)
    if os.path.isdir(home):
        actual = stat.S_IMODE(os.stat(home).st_mode)
        report(actual == 0o755, f"{home} mode {actual:o} (want 755)")
    if content is not None:
        report(stat.S_IMODE(os.stat(auth_path).st_mode) == 0o600,
               f"{auth_path} mode 600")

    # AI ops (optional): user/key/sudoers/ownership/modes and the from= restriction. A normal
    # `ai-ops disable` keeps the locked account but removes the key and the rule: that is a
    # healthy disabled state, not a failure.
    ai_ops_user = user_exists(runner, AI_OPS_USER)
    ai_ops_auth = ai_ops_authorized_keys_path(runner)
    ai_ops_dir = ai_ops_ssh_dir(runner)
    ai_ops_sudoers = runner.target(AI_OPS_SUDOERS_PATH)
    ai_ops_content = read_file(ai_ops_auth)
    ai_ops_key_present = ai_ops_content is not None
    ai_ops_sudoers_present = os.path.exists(ai_ops_sudoers)
    if not ai_ops_key_present and not ai_ops_sudoers_present:
        say(f"ok:   ai-ops access disabled "
            f"({'locked account kept' if ai_ops_user else 'not configured'})")
    else:
        report(ai_ops_user, f"user {AI_OPS_USER} exists")
        report(ai_ops_key_present and ai_ops_sudoers_present,
               f"ai-ops access enabled (key={'yes' if ai_ops_key_present else 'no'}, "
               f"sudoers={'yes' if ai_ops_sudoers_present else 'no'})")
        if ai_ops_key_present:
            ai_ops_lines = [line for line in ai_ops_content.splitlines() if line.strip()]
            report(len(ai_ops_lines) == 1, f"{ai_ops_auth} has exactly one managed key line")
            report(any('from="' in line for line in ai_ops_lines),
                   f"{ai_ops_auth} restricts the key with from=", warning=True)
            report(stat.S_IMODE(os.stat(ai_ops_auth).st_mode) == 0o600,
                   f"{ai_ops_auth} mode 600")
            if os.path.isdir(ai_ops_dir):
                report(stat.S_IMODE(os.stat(ai_ops_dir).st_mode) == 0o700,
                       f"{ai_ops_dir} mode 700")
        if ai_ops_sudoers_present:
            actual = stat.S_IMODE(os.stat(ai_ops_sudoers).st_mode)
            report(actual == 0o440, f"{ai_ops_sudoers} mode {actual:o} (want 440)")
            if runner.have("visudo"):
                proc = runner.run("visudo", "-cf", ai_ops_sudoers)
                report(proc.ok, f"visudo accepts {ai_ops_sudoers}")
            else:
                report(False, "visudo is not available to check the ai-ops sudoers file")
        if not runner.test_mode and ai_ops_user:
            import pwd
            try:
                ai_ops_uid = pwd.getpwnam(AI_OPS_USER).pw_uid
            except KeyError:
                ai_ops_uid = None
            for path in (runner.target(AI_OPS_HOME), ai_ops_dir, ai_ops_auth):
                if ai_ops_uid is not None and os.path.exists(path):
                    owner = os.stat(path).st_uid
                    report(owner == ai_ops_uid,
                           f"{path} owned by {AI_OPS_USER} (sshd refuses the key otherwise)")

    if runner.have("sshd"):
        proc = runner.run("sshd", "-T")
        if proc.ok:
            allow_users, allow_groups = parse_sshd_allow(proc.out)
            if allow_users or allow_groups:
                for account in (DEPLOY_USER, AI_OPS_USER):
                    problem = sshd_allow_excludes(runner, account, allow_users, allow_groups)
                    report(problem is None,
                           problem or f"sshd AllowUsers/AllowGroups allows {account}",
                           warning=True)
        else:
            say("warn: `sshd -T` failed; cannot check AllowUsers/AllowGroups")

    sudoers = runner.target(SUDOERS_PATH)
    if os.path.exists(sudoers):
        actual = stat.S_IMODE(os.stat(sudoers).st_mode)
        report(actual == 0o440, f"{sudoers} mode {actual:o} (want 440)")
        if runner.have("visudo"):
            proc = runner.run("visudo", "-cf", sudoers)
            report(proc.ok, f"visudo accepts {sudoers}")
        else:
            report(False, "visudo is not available to check sudoers")
    else:
        report(not document.get("apps"), "sudoers has no ai-deploy rules (no apps configured)",
               warning=bool(document.get("apps")))

    for name in sorted(document.get("apps", {})):
        app = document["apps"][name]
        kind = app.get("kind", "service")
        root = app.get("root", "")
        if app.get("sshKey"):
            report(os.path.exists(app["sshKey"]), f"{name}: deploy key present")
            if os.path.exists(app["sshKey"]):
                actual = stat.S_IMODE(os.stat(app["sshKey"]).st_mode)
                report(actual == 0o600, f"{name}: deploy key mode {actual:o} (want 600)")
        if app.get("repo") and app.get("sshKey") and app.get("knownHosts") and runner.have("git"):
            env = dict(os.environ)
            env["GIT_SSH_COMMAND"] = git_ssh_command(app["sshKey"], app["knownHosts"])
            env["GIT_TERMINAL_PROMPT"] = "0"
            proc = runner.run("git", "ls-remote", app["repo"], env=env, timeout=20)
            report(proc.ok, f"{name}: repo reachable ({app['repo']})", warning=True)
        if kind == "service" and app.get("unit"):
            state = runner.run("systemctl", "is-active", app["unit"])
            active = state.out.strip() or ("active" if state.ok else "inactive")
            report(state.ok or active in ("inactive", "failed"),
                   f"{name}: unit {app['unit']} is {active}", warning=not state.ok)
            report(os.path.islink(os.path.join(root, "current")),
                   f"{name}: current release set", warning=True)
        health = app.get("health")
        if health and health.get("type") == "http":
            ok, detail = http_health(health.get("url", ""))
            report(ok, f"{name}: health {health.get('url')} -> {detail}", warning=True)

    if runner.have("getenforce"):
        mode = runner.run("getenforce").out.strip()
        report(mode in ("Enforcing", "Permissive", "Disabled"), f"SELinux mode {mode}")
        if mode == "Enforcing":
            if runner.have("ausearch"):
                avc = runner.run("ausearch", "-m", "avc", "-ts", "recent")
                report(avc.ok, "recent AVC denials query", warning=True)
            elif runner.have("journalctl"):
                say("hint: check denials with `journalctl -t setroubleshoot` or `ausearch -m avc`")
    else:
        say("ok:   SELinux not present")

    say("hint: if SSH connections are throttled on OpenSSH >= 9.8, set "
        "`PerSourcePenalties no` in sshd_config")

    if failures:
        say(f"doctor: {failures} problem(s)")
        return 1
    say("doctor: no problems found")
    return 0


# --------------------------------------------------------------------------
# fingerprint / uninstall


def cmd_fingerprint(runner, args):
    files = host_key_files(runner)
    if not files:
        raise Fail("no /etc/ssh/ssh_host_*_key.pub found")
    say("SSH host key fingerprints:")
    print_host_key_fingerprints(runner)
    return 0


def cmd_uninstall(runner, args):
    require_root(runner)
    runner.os_info = detect_os(runner)
    if not confirm_action(runner, f"uninstall {PROG} from this machine?"):
        say("aborted")
        return 0
    document = load_document(runner)
    if document:
        for name in sorted(document.get("apps", {})):
            app = document["apps"][name]
            if app.get("kind", "service") == "service" and app.get("unit"):
                runner.mutate("systemctl", "stop", app["unit"], ignore_failure=True)
                runner.mutate("systemctl", "disable", app["unit"], ignore_failure=True)
                remove_file(runner, runner.target(f"/etc/systemd/system/{app['unit']}"))
            if app.get("kind") == "static":
                remove_file(runner, runner.target(NGINX_CONF_DIR + f"/ai-app-{name}.conf"))
        reseed_systemd(runner)
    remove_file(runner, runner.target(SUDOERS_PATH))
    remove_file(runner, runner.target(SSHD_DROPIN))
    remove_file(runner, runner.target(GATEWAY_PATH))
    remove_file(runner, runner.target(COMPOSE_UP_PATH))
    remove_file(runner, runner.target(INSTALLED_VERSION_PATH))
    if args.purge:
        remove_file(runner, runner.target(CONFIG_PATH))
        remove_file(runner, deploy_authorized_keys_path(runner))
        if document:
            for name in sorted(document.get("apps", {})):
                remove_file(runner, app_env_path(runner, name))
                remove_tree(runner, app_root_path(runner, name))
                remove_tree(runner, runner.target("/var/lib/" + service_state_dir(name)))
                if user_exists(runner, "app-" + name):
                    runner.mutate("userdel", "app-" + name, ignore_failure=True)
        if user_exists(runner, DEPLOY_USER):
            runner.mutate("userdel", DEPLOY_USER, ignore_failure=True)
        remove_tree(runner, runner.target(DEPLOY_HOME))
    say(f"{PROG} uninstalled" + (" (purged data)" if args.purge else ""))
    return 0


# --------------------------------------------------------------------------
# argument parsing / entry point


def require_root(runner):
    if runner.test_mode or runner.check:
        return
    if os.geteuid() != 0:
        raise Fail("must run as root on the target (or use --check for a dry run)", 3)


def add_common(parser, check=True, yes=True):
    parser.add_argument("--root", default="/", metavar="DIR",
                        help="test prefix (requires AI_DEPLOY_TARGET_TEST=1)")
    if check:
        parser.add_argument("--check", action="store_true", help="print the plan, change nothing")
    if yes:
        parser.add_argument("--yes", action="store_true",
                            help="accept defaults (fails when a required answer has no default)")


def make_runner(args):
    root = getattr(args, "root", "/") or "/"
    check = getattr(args, "check", False)
    yes = getattr(args, "yes", False)
    test_mode = False
    if root != "/":
        if os.environ.get("AI_DEPLOY_TARGET_TEST") != "1":
            raise Fail("--root requires AI_DEPLOY_TARGET_TEST=1", 2)
        if not os.path.isabs(root):
            raise Fail("--root must be an absolute path", 2)
        if not os.path.isdir(root):
            raise Fail(f"--root {root} does not exist", 2)
        root = root.rstrip("/") or "/"
        test_mode = True
    return Runner(root, test_mode, check, yes)


def build_parser():
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Guided setup for an ai-deploy target (Debian/Ubuntu or Rocky Linux).",
    )
    parser.add_argument("--version", action="version",
                        version=f"{PROG} {package_version()}")
    sub = parser.add_subparsers(dest="command")

    bootstrap = sub.add_parser("bootstrap", help="prepare this machine as a deploy target")
    add_common(bootstrap)
    bootstrap.add_argument("--deploy-key", metavar="KEY",
                           help="VM deploy public key line (repeatable replacement)")
    bootstrap.add_argument("--add-deploy-key", nargs="?", const="", default=None, metavar="KEY",
                           help="add the key to the existing managed keys instead of replacing")
    bootstrap.add_argument("--admin-user", metavar="NAME", help="existing (or new) sudo admin user")
    bootstrap.add_argument("--admin-key", metavar="KEY", help="admin user's public key line")
    bootstrap.add_argument("--ai-ops-key", metavar="KEY",
                           help="AI ops public key line (enables TOTP-gated AI admin access)")
    bootstrap.add_argument("--ai-ops-from", metavar="CIDR",
                           help="comma-separated source addresses/CIDRs allowed to use the AI ops "
                                "key (max 8; default: this SSH client's IP)")
    bootstrap.add_argument("--no-root-login-change", action="store_true",
                           help="leave PermitRootLogin unchanged")
    bootstrap.add_argument("--root-login-change", action="store_true",
                           help="apply the PermitRootLogin drop-in without the second-terminal ask")

    app = sub.add_parser("app", help="manage configured apps")
    app_sub = app.add_subparsers(dest="app_command")

    add = app_sub.add_parser("add", help="configure a new app")
    add.add_argument("name")
    add_common(add)
    add.add_argument("--kind", choices=["service", "static", "compose"])
    add.add_argument("--repo", metavar="URL")
    add.add_argument("--host-key-line", metavar="LINE",
                     help="known_hosts line for a non-GitHub repository host")
    add.add_argument("--preset", choices=["node", "python", "custom"])
    add.add_argument("--build", action="append", metavar="STEP",
                     help="build step command line (repeatable)")
    add.add_argument("--no-build", action="store_true", help="configure no build steps")
    add.add_argument("--start", metavar="CMD", help="service start command line")
    add.add_argument("--port", type=int)
    add.add_argument("--health-url", metavar="URL")
    add.add_argument("--ai-deploy", action="store_true", help="allow AI-initiated deploys")
    add.add_argument("--keep", type=int)
    add.add_argument("--static-dir", metavar="DIR", help="static site output directory")
    add.add_argument("--compose-file", metavar="FILE")
    add.add_argument("--server-name", metavar="NAME", help="nginx server_name for static apps")
    add.add_argument("--no-nginx", action="store_true", help="do not write an nginx config")
    add.add_argument("--env", action="append", metavar="KEY=VALUE")

    remove = app_sub.add_parser("remove", help="remove an app")
    remove.add_argument("name")
    add_common(remove)
    remove.add_argument("--purge", action="store_true",
                        help="also remove app data, user, env file and state dir")

    listing = app_sub.add_parser("list", help="list configured apps")
    add_common(listing, check=False, yes=False)

    ai_ops = sub.add_parser("ai-ops", help="manage TOTP-gated AI admin access")
    ai_ops_sub = ai_ops.add_subparsers(dest="ai_ops_command")

    ai_ops_enable = ai_ops_sub.add_parser(
        "enable", help="install the ai-ops key and passwordless sudo rule")
    add_common(ai_ops_enable)
    ai_ops_enable.add_argument("--key", metavar="KEY", help="AI ops public key line")
    ai_ops_enable.add_argument("--from", dest="source", metavar="CIDR",
                               help="comma-separated source addresses/CIDRs allowed (max 8)")

    ai_ops_disable = ai_ops_sub.add_parser(
        "disable", help="remove the ai-ops key and sudo rule and lock the account")
    add_common(ai_ops_disable)

    ai_ops_status = ai_ops_sub.add_parser("status", help="show the AI ops access state")
    add_common(ai_ops_status, check=False, yes=False)

    doctor = sub.add_parser("doctor", help="check the target state")
    add_common(doctor, check=False, yes=False)

    fingerprint = sub.add_parser("fingerprint", help="print SSH host key fingerprints")
    add_common(fingerprint, check=False, yes=False)

    uninstall = sub.add_parser("uninstall", help="remove the package from this machine")
    add_common(uninstall)
    uninstall.add_argument("--purge", action="store_true", help="also remove app data and users")

    return parser


HANDLERS = {
    "bootstrap": cmd_bootstrap,
    "doctor": cmd_doctor,
    "fingerprint": cmd_fingerprint,
    "uninstall": cmd_uninstall,
}

APP_HANDLERS = {
    "add": cmd_app_add,
    "remove": cmd_app_remove,
    "list": cmd_app_list,
}

AI_OPS_HANDLERS = {
    "enable": cmd_ai_ops_enable,
    "disable": cmd_ai_ops_disable,
    "status": cmd_ai_ops_status,
}


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "command", None):
        parser.print_help(sys.stderr)
        return 2
    try:
        runner = make_runner(args)
        if args.command == "app":
            handler = APP_HANDLERS.get(getattr(args, "app_command", None))
            if handler is None:
                print("error: `app` needs one of: add, remove, list", file=sys.stderr)
                return 2
        elif args.command == "ai-ops":
            handler = AI_OPS_HANDLERS.get(getattr(args, "ai_ops_command", None))
            if handler is None:
                print("error: `ai-ops` needs one of: enable, disable, status", file=sys.stderr)
                return 2
        else:
            handler = HANDLERS[args.command]
        return handler(runner, args)
    except Fail as exc:
        print(f"error: {exc}", file=sys.stderr)
        return exc.code
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
