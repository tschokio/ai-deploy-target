def cmd_ai_ops_status(runner, args):
    runner.os_info = detect_os(runner)
    user = user_exists(runner, AI_OPS_USER)
    auth_path = ai_ops_authorized_keys_path(runner)
    content = read_file(auth_path)
    sudoers = runner.target(AI_OPS_SUDOERS_PATH)
    sources = ""
    for line in (content or "").splitlines():
        match = re.search(r'from="([^"]*)"', line)
        if match:
            sources = match.group(1)
    say(f"{PROG} {package_version()} ai-ops status")
    say(f"user:     {AI_OPS_USER} " + ("present" if user else "missing"))
    if user:
        info = getent_passwd(runner, AI_OPS_USER) or {}
        say(f"shell:    {info.get('shell') or '(unknown)'}")
    say(f"key:      {auth_path} " + ("present" if content is not None else "missing"))
    say(f"from:     {sources or '(any source — unrestricted)'}")
    say(f"sudoers:  {sudoers} " + ("present" if os.path.exists(sudoers) else "missing"))
    enabled = bool(user and content is not None and os.path.exists(sudoers))
    say(f"state:    {'enabled' if enabled else 'disabled'}")
    return 0


def cmd_bootstrap(runner, args):
    require_root(runner)
    say(f"{PROG} {package_version()} bootstrap (root={runner.root}, check={runner.check})")
    runner.os_info = detect_os(runner)
    if runner.os_info.get("family") is None:
        say("warning: /etc/os-release did not match a known family; package installation disabled")
    bootstrap_prerequisites(runner)
    ensure_deploy_user(runner)
    install_package_files(runner)
    ensure_apps_json(runner)

    deploy_keys = []
    additive = args.add_deploy_key is not None
    if args.deploy_key:
        deploy_keys.append(args.deploy_key)
    if args.add_deploy_key:
        deploy_keys.append(args.add_deploy_key)
    if not deploy_keys:
        if runner.yes:
            raise Fail("--yes was given but no --deploy-key; pass --deploy-key", 2)
        deploy_keys.append(ask(runner, "Paste the VM deploy public key (ssh-ed25519 ...)",
                               required=True))
    parsed = [validate_public_key(runner, key) for key in deploy_keys]
    write_deploy_authorized_keys(runner, parsed, additive)
    say(f"installed {len(parsed)} managed line(s) in {deploy_authorized_keys_path(runner)}")

    admin_user = setup_admin_user(runner, args)
    setup_root_login(runner, args, admin_user)
    setup_ai_ops(runner, args)
    handle_selinux(runner)

    say("")
    say("SSH host key fingerprints:")
    print_host_key_fingerprints(runner)
    say("")
    say("bootstrap complete")
    return 0


