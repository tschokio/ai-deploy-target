SELINUX_FCONTEXT_RULES = (
    ("ssh_home_t", r"/srv/ai-deploy/\.ssh(/.*)?"),
    ("bin_t", r"/srv/ai-deploy/[^/]+/releases/[^/]+/(\.venv/bin|node_modules/\.bin)(/.*)?"),
    ("httpd_sys_content_t", r"/srv/ai-deploy/[^/]+/releases(/.*)?"),
)


def handle_selinux(runner):
    if not runner.have("getenforce"):
        return
    mode = runner.run("getenforce").out.strip()
    if mode not in ("Enforcing", "Permissive"):
        say(f"SELinux is {mode or 'disabled'}; no fcontext rules needed")
        return
    say(f"SELinux is {mode}; registering ai-deploy fcontext rules")
    if not runner.have("semanage"):
        say("warning: semanage is not available; install policycoreutils-python-utils and re-run")
        return
    for context, pattern in SELINUX_FCONTEXT_RULES:
        added = runner.mutate("semanage", "fcontext", "-a", "-t", context, pattern,
                              ignore_failure=True)
        if not added.ok and not runner.check:
            runner.mutate("semanage", "fcontext", "-m", "-t", context, pattern,
                          ignore_failure=True)
    runner.mutate("restorecon", "-R", runner.target(DEPLOY_HOME), ignore_failure=True)


