def cmd_app_remove(runner, args):
    require_root(runner)
    runner.os_info = detect_os(runner)
    name = args.name
    if not APP_RE.fullmatch(name):
        raise Fail("app name must match ^[a-z0-9][a-z0-9-]{0,31}$", 2)
    document = load_document(runner)
    if document is None or not app_exists(document, name):
        raise Fail(f"app {name} is not configured in {runner.target(CONFIG_PATH)}")
    if not confirm_action(runner, f"remove app {name}?"):
        say("aborted")
        return 0
    entry = document["apps"].pop(name)
    kind = entry.get("kind", "service")
    if kind == "service" and entry.get("unit"):
        runner.mutate("systemctl", "stop", entry["unit"], ignore_failure=True)
        runner.mutate("systemctl", "disable", entry["unit"], ignore_failure=True)
        remove_file(runner, runner.target(f"/etc/systemd/system/{entry['unit']}"))
        reseed_systemd(runner)
    if kind == "static":
        snippet = runner.target(NGINX_CONF_DIR + f"/ai-app-{name}.conf")
        if os.path.exists(snippet) or runner.check:
            remove_file(runner, snippet)
            if runner.have("nginx"):
                runner.mutate("systemctl", "reload", "nginx", ignore_failure=True)
    regenerate_sudoers(runner, document)
    install_document(runner, document)
    if args.purge:
        remove_tree(runner, app_root_path(runner, name))
        remove_file(runner, app_env_path(runner, name))
        remove_tree(runner, runner.target("/var/lib/" + service_state_dir(name)))
        if user_exists(runner, "app-" + name):
            runner.mutate("userdel", "app-" + name, ignore_failure=True)
    say(f"app {name} removed" + (" (purged)" if args.purge else ""))
    return 0


def cmd_app_list(runner, args):
    document = load_document(runner)
    if document is None:
        say(f"no {runner.target(CONFIG_PATH)} found; run bootstrap first")
        return 0
    apps = document.get("apps", {})
    if not apps:
        say("no apps configured")
        return 0
    for name in sorted(apps):
        app = apps[name]
        unit = app.get("unit") or "-"
        say(f"{name}\t{app.get('kind', 'service')}\t{unit}\taiDeploy={bool(app.get('aiDeploy'))}"
            f"\t{app.get('repo', '')}")
    return 0


