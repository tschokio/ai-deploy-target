# users


def getent_passwd(runner, user):
    proc = runner.run("getent", "passwd", user)
    if not proc.ok:
        return None
    fields = proc.out.strip().split(":")
    if len(fields) < 7:
        return None
    return {"name": fields[0], "home": fields[5], "shell": fields[6]}


def user_exists(runner, user):
    return runner.run("getent", "passwd", user).ok


def user_in_group(runner, user, group):
    proc = runner.run("id", "-nG", user)
    return proc.ok and group in proc.out.split()


def nologin_path(runner):
    for candidate in ("/usr/sbin/nologin", "/sbin/nologin"):
        if os.path.exists(runner.target(candidate)):
            return runner.target(candidate)
    return "/usr/sbin/nologin"


def warn_no_password(runner, user):
    proc = runner.run("getent", "shadow", user)
    if not proc.ok:
        return
    fields = proc.out.strip().split(":")
    if len(fields) >= 2 and fields[1] in ("", "!", "!!", "*", "NP"):
        say(f"warning: user {user} has no usable password; sudo login (and thus the deploy "
            f"path) will not work until one is set with `passwd {user}`")


