def make_app_command_list(text):
    try:
        argv = shlex.split(text)
    except ValueError as exc:
        raise Fail(f"cannot parse command {text!r}: {exc}")
    if not argv:
        raise Fail("empty command")
    return argv


def resolve_executable(runner, argv):
    if not argv:
        raise Fail("empty start command")
    if argv[0].startswith("/"):
        return list(argv)
    resolved = runner.which(argv[0])
    if resolved is None:
        if runner.test_mode:
            return list(argv)
        raise Fail(f"cannot resolve {argv[0]!r} to an absolute path; is it installed?")
    return [resolved, *argv[1:]]


def app_repo_host(repo):
    match = re.match(r"^(?:ssh://)?(?:[^@/]+@)?([^:/]+)[:/]", repo)
    return match.group(1) if match else ""


def ensure_app_key(runner, name, app_root):
    ssh_dir = os.path.join(app_root, ".ssh")
    key = os.path.join(ssh_dir, "github_ed25519")
    pub = key + ".pub"
    ensure_dir(runner, ssh_dir, 0o700, owner=f"{DEPLOY_USER}:{DEPLOY_USER}")
    comment = f"ai-deploy@{socket.gethostname()}:{name}"
    if runner.check:
        plan(f"ssh-keygen -t ed25519 -N '' -C {comment} -f {key}")
        return key, pub
    if os.path.exists(key):
        say(f"keeping existing GitHub deploy key: {key}")
    else:
        runner.mutate("ssh-keygen", "-t", "ed25519", "-N", "", "-C", comment, "-f", key)
        runner.mutate("chown", f"{DEPLOY_USER}:{DEPLOY_USER}", key, pub)
    return key, pub


def write_known_hosts(runner, app_root, repo, host_key_line=None):
    path = os.path.join(app_root, ".ssh", "known_hosts")
    host = app_repo_host(repo)
    if host == "github.com":
        content = "".join(line + "\n" for line in GITHUB_KNOWN_HOSTS)
    else:
        say(f"repository host {host!r} is not github.com; paste its SSH host key line")
        line = host_key_line or ask(runner, f"{host} host key line (e.g. from ssh-keyscan {host})",
                                    required=True)
        validate_host_key_line(runner, line)
        content = line.strip() + "\n"
    write_file(runner, path, content, 0o644, owner=f"{DEPLOY_USER}:{DEPLOY_USER}")
    return path


def print_deploy_key_instructions(runner, name, pub_path):
    public = read_file(pub_path, "") or ""
    say("")
    say("GitHub deploy key for this app:")
    say("  " + (public.strip() or "(would be generated at " + pub_path + ")"))
    say("Add it in GitHub -> the repository -> Settings -> Deploy keys -> Add deploy key:")
    say(f"  title: ai-deploy {socket.gethostname()} {name} (leave 'Allow write access' unchecked)")
    wait_enter(runner, "Press Enter once the deploy key is added (or skip the check below):")


def git_ssh_command(key_path, known_hosts_path):
    return ("ssh -F /dev/null -i " + shlex.quote(key_path)
            + " -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes"
            + " -o UserKnownHostsFile=" + shlex.quote(known_hosts_path))


def test_git_remote(runner, key_path, known_hosts_path, repo):
    if runner.check:
        plan(f"test `git ls-remote {repo}` as {DEPLOY_USER} with the app key")
        return True
    env = dict(os.environ)
    env["GIT_SSH_COMMAND"] = git_ssh_command(key_path, known_hosts_path)
    env["GIT_TERMINAL_PROMPT"] = "0"
    while True:
        proc = runner.run("git", "ls-remote", repo, env=env)
        if proc.ok:
            say("git ls-remote succeeded")
            return True
        detail = [line for line in (proc.err or proc.out).strip().splitlines() if line.strip()]
        text = " ".join(detail)
        say("git ls-remote failed" + (": " + " | ".join(detail[-3:]) if detail else ""))
        if "Permission denied (publickey)" in text or "Please make sure you have the correct access" in text:
            say("  -> GitHub does not accept the key yet: add the public key above as a Deploy key of this "
                "repository (read-only), then retry")
        elif "Host key verification failed" in text:
            say("  -> the repository host's key does not match the pinned known_hosts; do not continue "
                "unless you verified the host key out of band")
        if runner.yes:
            say("warning: skipping the deploy-key check (--yes)")
            return False
        answer = _read("Press Enter to retry, or type 's' to skip: ").strip().lower()
        if answer == "s":
            say("warning: deploy-key check skipped")
            return False


def parse_env_args(values):
    result = {}
    for item in values or []:
        key, sep, value = item.partition("=")
        if not sep or not ENV_NAME_RE.fullmatch(key):
            raise Fail(f"--env expects KEY=VALUE with a valid name, got {item!r}")
        result[key] = value
    return result


def build_service_entry(runner, args, name, repo, app_root, key_path, known_hosts):
    preset = args.preset
    if preset is None:
        preset = ask_choice(runner, "Service preset", ["node", "python", "custom"], "node")
    if preset == "node":
        ensure_node_prerequisites(runner)
    elif preset == "python":
        ensure_python_prerequisites(runner)
    port = args.port
    if port is None:
        port = int(ask(runner, "Local port the app listens on",
                       default="3000" if preset != "python" else "8000"))
    if preset == "node":
        default_build = [["npm", "ci"], ["npm", "run", "build"]]
        default_start = ["/usr/bin/node", "server.js"]
    elif preset == "python":
        default_build = [["python3", "-m", "venv", ".venv"],
                         [".venv/bin/pip", "install", "-r", "requirements.txt"]]
        default_start = [app_root + "/current/.venv/bin/gunicorn", "-b",
                         f"127.0.0.1:{port}", "app:app"]
    else:
        default_build = []
        default_start = None
    if args.no_build:
        build = []
    elif args.build:
        build = [make_app_command_list(step) for step in args.build]
    else:
        build = [list(step) for step in default_build]
    if args.start:
        start = make_app_command_list(args.start)
    elif default_start is not None:
        start = list(default_start)
    else:
        start = make_app_command_list(ask(runner, "Start command (full command line)",
                                          required=True))
    start = resolve_executable(runner, start)
    health_url = args.health_url
    if health_url is None:
        health_url = ask(runner, "Health check URL", default=f"http://127.0.0.1:{port}/")
    entry = {
        "kind": "service",
        "repo": repo,
        "sshKey": key_path,
        "knownHosts": known_hosts,
        "root": app_root,
        "build": build,
        "buildTimeout": 900,
        "env": parse_env_args(args.env),
        "unit": f"ai-app-{name}.service",
        "mode": "system",
        "health": {"type": "http", "url": health_url, "timeout": 5,
                   "totalSeconds": 60, "interval": 2},
        "aiDeploy": bool(args.ai_deploy),
        "keep": args.keep if args.keep is not None else 5,
    }
    return entry, start, port


def build_static_entry(runner, args, name, repo, app_root, key_path, known_hosts):
    output_dir = args.static_dir or ask(runner, "Static output directory (inside the release)",
