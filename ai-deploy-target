def nginx_snippet(runner, name, app_root, output_dir, server_name):
    root = f"{app_root}/current/{output_dir}".rstrip("/")
    return (
        f"# Managed by {PROG} for app {name}\n"
        "server {\n"
        "    listen 80;\n"
        f"    server_name {server_name};\n"
        f"    root {root};\n"
        "    index index.html;\n"
        "    location / {\n"
        "        try_files $uri $uri/ =404;\n"
        "    }\n"
        "}\n"
    )


def setup_static_nginx(runner, args, name, app_root, output_dir):
    if not runner.have("nginx"):
        say("nginx is not installed; here is the server snippet to add by hand:")
        say(nginx_snippet(runner, name, app_root, output_dir, name).rstrip())
        say("")
        say("# Caddy equivalent:")
        say(f"# {app_root}/current/{output_dir} {{ file_server }}")
        return
    if args.no_nginx:
        say("nginx detected but --no-nginx was given; snippet not written")
        return
    server_name = args.server_name or name
    if not runner.yes and not confirm(runner, f"write an nginx server for {name}?", default=True):
        return
    path = runner.target(NGINX_CONF_DIR + f"/ai-app-{name}.conf")
    write_file(runner, path, nginx_snippet(runner, name, app_root, output_dir, server_name),
               0o644, owner="root:root")
    if runner.check:
        plan("nginx -t")
        plan("systemctl reload nginx")
        return
    proc = runner.run("nginx", "-t")
    if not proc.ok:
        detail = (proc.err or proc.out).strip()
        remove_file(runner, path)
        raise Fail(f"nginx -t rejected the config; removed {path}: {detail or 'exit %d' % proc.rc}")
    runner.mutate("systemctl", "reload", "nginx")
    say("nginx config installed and reloaded")


def build_compose_entry(runner, args, name, repo, app_root, key_path, known_hosts):
    say("warning: a compose app restarts containers through a root-owned wrapper — treat it as "
        "root-equivalent code from the repository.")
    if runner.have("docker"):
        proc = runner.run("docker", "compose", "version")
        if not proc.ok:
            say("warning: `docker compose version` failed; install the Docker compose plugin "
                "(https://docs.docker.com) before deploying")
    else:
        say("warning: docker is not installed; install it from https://docs.docker.com "
            "(ai-deploy-target does not install Docker)")
    compose_file = args.compose_file or ask(runner, "Compose file (relative to the release)",
                                            default="compose.yml")
    if compose_file.startswith("/") or ".." in Path(compose_file).parts:
        raise Fail("compose file must be a relative path without '..'")
    health_url = args.health_url
    entry = {
        "kind": "compose",
        "repo": repo,
        "sshKey": key_path,
        "knownHosts": known_hosts,
        "root": app_root,
        "build": [],
        "buildTimeout": 900,
        "env": parse_env_args(args.env),
        "unit": None,
        "mode": "system",
        "health": ({"type": "http", "url": health_url, "timeout": 5,
                    "totalSeconds": 60, "interval": 2} if health_url else None),
        "aiDeploy": bool(args.ai_deploy),
        "keep": args.keep if args.keep is not None else 5,
        "compose": {"file": compose_file, "project": name},
    }
    return entry


def setup_service_runtime(runner, name):
    ensure_app_user(runner, name)
    env_path = app_env_path(runner, name)
    write_file(runner, env_path, "", 0o640, owner=f"root:app-{name}")
    return env_path


def install_service_unit(runner, name, start_argv, port):
    unit = f"ai-app-{name}.service"
    unit_path = runner.target(f"/etc/systemd/system/{unit}")
    write_file(runner, unit_path, unit_content(runner, name, start_argv, port), 0o644,
               owner="root:root")
    reseed_systemd(runner)
    runner.mutate("systemctl", "enable", unit)
    say(f"unit {unit} written and enabled (it will start on the first deploy)")
    return unit


def cmd_app_add(runner, args):
    require_root(runner)
    runner.os_info = detect_os(runner)
    name = args.name
    if not APP_RE.fullmatch(name):
        raise Fail("app name must match ^[a-z0-9][a-z0-9-]{0,31}$", 2)
    document = load_document(runner) or empty_document()
    if app_exists(document, name):
        raise Fail(f"app {name} already exists; remove it first (`{PROG} app remove {name}`)")

    kind = args.kind or ask_choice(runner, "App kind", ["service", "static", "compose"], "service")
    if args.repo:
        repo = args.repo
    else:
        repo = ask(runner, "Repository SSH URL (git@github.com:owner/repo.git)", required=True)
    if repo.startswith("-") or not repo:
        raise Fail("repository URL must be a non-empty string not starting with '-'")
    local_repo = repo.startswith("/")
    if not local_repo and not repo.startswith(("git@", "ssh://", "https://", "http://")):
        say(f"warning: {repo!r} does not look like a git URL")
    if not args.ai_deploy and not runner.yes:
        if confirm(runner, "Allow AI-initiated deploys for this app?", default=False):
            args.ai_deploy = True

    app_root = app_root_path(runner, name)
    ensure_dir(runner, app_root, 0o755, owner=f"{DEPLOY_USER}:{DEPLOY_USER}")
    if local_repo:
        # A repository on this machine (e.g. a bare repo): no SSH key, no host key.
        say(f"local repository {repo}: no deploy key needed")
        key_path = known_hosts = None
    else:
        key_path, pub_path = ensure_app_key(runner, name, app_root)
        known_hosts = write_known_hosts(runner, app_root, repo, args.host_key_line)
        print_deploy_key_instructions(runner, name, pub_path)
        if not test_git_remote(runner, key_path, known_hosts, repo):
            say("warning: continuing without a verified deploy key; the first deploy will fail until "
                "the key is added to GitHub")

    if kind == "service":
        entry, start_argv, port = build_service_entry(runner, args, name, repo, app_root,
                                                      key_path, known_hosts)
    elif kind == "static":
        entry, output_dir = build_static_entry(runner, args, name, repo, app_root, key_path,
                                               known_hosts)
    else:
        entry = build_compose_entry(runner, args, name, repo, app_root, key_path, known_hosts)

    document["apps"][name] = entry
    # Validate the whole document before changing any other part of the system.
    validate_document(runner, document)

    if kind == "service":
        setup_service_runtime(runner, name)
        install_service_unit(runner, name, start_argv, port)
    elif kind == "compose":
        setup_service_runtime(runner, name)

    regenerate_sudoers(runner, document)
    install_document(runner, document)

    if kind == "static":
        setup_static_nginx(runner, args, name, app_root, output_dir)

    say("")
    say(f"app {name} ({kind}) configured")
    say(f"  root:   {app_root}")
    say(f"  repo:   {repo}")
    say(f"  key:    {key_path}")
    say(f"  aiDeploy: {entry['aiDeploy']}  keep: {entry['keep']}")
    say("")
    say("next: on the VM run `ai-remote status <machine>` and "
        f"`ai-remote deploy <machine> {name} --sha <full sha>`")
    return 0


