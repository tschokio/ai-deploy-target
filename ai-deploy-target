def setup_admin_user(runner, args):
    default_user = os.environ.get("SUDO_USER") or None
    if default_user == "root":
        default_user = None
    admin_user = args.admin_user or ask(
        runner, "Admin user that can log in and run sudo", default=default_user, required=True)
    if admin_user == "root":
        # The admin level is a normal account that authenticates with a key and then needs its own sudo
        # password; root would also make "disable root login" lock out the only admin.
        raise Fail("the admin user must be a normal account, not root: pass e.g. `--admin-user domi` "
                   "(an existing sudo user, or a new one this tool creates and asks a password for)", 2)
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", admin_user):
        raise Fail(f"invalid admin user name {admin_user!r}", 2)
    sudo_group = "sudo" if runner.os_info.get("family") == "debian" else "wheel"
    if user_exists(runner, admin_user):
        say(f"user {admin_user} exists")
    else:
        runner.mutate("useradd", "-m", "-s", "/bin/bash", admin_user)
        say(f"created user {admin_user}; set its password now")
        runner.interactive("passwd", admin_user)
    if not user_in_group(runner, admin_user, sudo_group):
        runner.mutate("usermod", "-aG", sudo_group, admin_user)
        say(f"added {admin_user} to the {sudo_group} group")
    else:
        say(f"{admin_user} is already in the {sudo_group} group")
    warn_no_password(runner, admin_user)

    if args.admin_key:
        key_line = args.admin_key
    elif runner.yes:
        say(f"no --admin-key given: {admin_user}'s authorized_keys left unchanged (add the admin key later by "
            f"re-running bootstrap with --admin-key)")
        return admin_user
    else:
        key_line = ask(runner, "Paste the admin user's public key (ssh-ed25519 ...), or press Enter to skip",
                       default="", required=False)
        if not key_line:
            say(f"skipped: {admin_user}'s authorized_keys left unchanged")
            return admin_user
    key_type, blob = validate_public_key(runner, key_line)
    info = getent_passwd(runner, admin_user) or {}
    home = info.get("home") or f"/home/{admin_user}"
    home_target = runner.target(home) if home.startswith("/") else home
    ssh_dir = os.path.join(home_target, ".ssh")
    ensure_dir(runner, ssh_dir, 0o700)
    auth_path = os.path.join(ssh_dir, "authorized_keys")
    existing = read_file(auth_path, "") or ""
    new_line = f"{key_type} {blob}"
    if any(new_line in line for line in existing.splitlines()):
        say(f"admin key already present in {auth_path}")
    else:
        content = existing.rstrip("\n")
        content = (content + "\n" if content else "") + new_line + "\n"
        write_file(runner, auth_path, content, 0o600)
    runner.mutate("chown", f"{admin_user}:{admin_user}", ssh_dir, auth_path)
    return admin_user


def setup_root_login(runner, args, admin_user=None):
    if args.no_root_login_change:
        say("root login change skipped (--no-root-login-change)")
        return
    if not admin_user or admin_user == "root":
        say("root login left unchanged (no separate admin user configured)")
        return
    dropin = runner.target(SSHD_DROPIN)
    if args.root_login_change:
        proceed = True
    else:
        say("To disable password/root SSH login safely, first log in AS the admin user in a "
            "SECOND terminal and run `sudo -v`.")
        proceed = confirm(runner, "Have you verified admin login in a second terminal?", default=False)
    if not proceed:
        say("leaving PermitRootLogin unchanged (drop-in not written)")
        return
    service = "ssh" if runner.os_info.get("family") == "debian" else "sshd"
    if runner.check:
        plan(f"write {dropin} (PermitRootLogin no)")
        plan(f"sshd -t, then systemctl reload {service}")
        return
    write_file(runner, dropin,
               f"# Managed by {PROG}: disable direct root SSH login\nPermitRootLogin no\n",
               0o644, owner="root:root")
    proc = runner.run("sshd", "-t")
    if not proc.ok:
        detail = (proc.err or proc.out).strip()
        remove_file(runner, dropin)
        raise Fail(f"sshd rejected the config; removed the drop-in: {detail or 'exit %d' % proc.rc}")
    # Socket-activated sshd (newer Debian/Ubuntu: ssh.socket, ssh.service inactive) reads the config for every
    # new connection, so nothing needs reloading; `systemctl reload` would fail on the inactive service.
    if runner.run("systemctl", "is-active", "--quiet", service).ok:
        reload = runner.run("systemctl", "reload", service)
        if not reload.ok:
            remove_file(runner, dropin)
            runner.run("systemctl", "reload", service)
            detail = (reload.err or reload.out).strip().splitlines()
            raise Fail(f"`systemctl reload {service}` failed, so the drop-in was removed again and root login is "
                       f"unchanged: {detail[-1] if detail else 'exit %d' % reload.rc}")
        say(f"PermitRootLogin no applied; reloaded {service}")
    else:
        say(f"PermitRootLogin no applied ({service}.service is socket-activated or inactive: new connections "
            f"read the new config)")
    say(f"undo: sudo rm {dropin} (then `systemctl reload {service}` if it is running)")


