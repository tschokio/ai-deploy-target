def host_key_files(runner):
    return sorted(glob.glob(runner.target("/etc/ssh/ssh_host_*_key.pub")))


def print_host_key_fingerprints(runner):
    files = host_key_files(runner)
    if not files and not runner.test_mode:
        # A freshly installed openssh-server that never started has no host keys yet.
        say("no SSH host keys yet; generating them with `ssh-keygen -A`")
        runner.mutate("ssh-keygen", "-A", ignore_failure=True)
        files = host_key_files(runner)
    if not files:
        say("no /etc/ssh/ssh_host_*_key.pub found; check that openssh-server generated host keys")
        return None
    ed25519 = None
    for path in files:
        proc = runner.run("ssh-keygen", "-lf", path)
        line = proc.out.strip() or f"warning: cannot read {path}"
        say(f"  {line}")
        if "ed25519" in os.path.basename(path):
            ed25519 = line
    if ed25519:
        say("")
        say("Next on the VM: type this ED25519 fingerprint into `ai-remote onboard <machine>`")
        say(f"  {ed25519}")
    return ed25519


