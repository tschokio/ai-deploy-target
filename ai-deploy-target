class Fail(Exception):
    """Explicit failure with an exit code (1 failure, 2 usage, 3 not root)."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


class Proc:
    __slots__ = ("rc", "out", "err")

    def __init__(self, rc, out="", err=""):
        self.rc = rc
        self.out = out or ""
        self.err = err or ""

    @property
    def ok(self):
        return self.rc == 0


def say(message=""):
    print(message, flush=True)   # keep stdout ordered with errors on stderr


def plan(message):
    print("plan: " + message)


# --------------------------------------------------------------------------
# runner: the single place every system command goes through


class Runner:
    def __init__(self, root, test_mode, check, yes):
        self.root = root
        self.test_mode = test_mode
        self.check = check
        self.yes = yes
        self.os_info = {}
        self._tools = {}
        self._gateway = None

    # -- paths -----------------------------------------------------------
    def target(self, path):
        if self.root == "/" or not path.startswith("/"):
            return path
        return self.root.rstrip("/") + path

    # -- command lookup --------------------------------------------------
    def which(self, name):
        if name not in self._tools:
            self._tools[name] = shutil.which(name)
        return self._tools[name]

    def have(self, name):
        return self.which(name) is not None

    def install_hint(self, packages):
        family = (self.os_info or {}).get("family")
        pkgs = " ".join(packages)
        if family == "debian":
            return f" — install it with: apt-get -y install {pkgs}"
        if family == "rocky":
            return f" — install it with: dnf -y install {pkgs}"
        return f" — install: {pkgs}" if packages else ""

    def require(self, name, packages=()):
        path = self.which(name)
        if path is None:
            raise Fail(f"{name} is not available" + self.install_hint(packages or (name,)))
        return path

    # -- execution -------------------------------------------------------
    def run(self, name, *args, env=None, input=None, capture=True, timeout=None):
        """Execute a command, always (used for probes / validation)."""
        path = self.which(name)
        if path is None:
            raise Fail(f"{name} is not available" + self.install_hint((name,)))
        argv = [path, *[str(a) for a in args]]
        try:
            if not capture:
                proc = subprocess.run(argv, env=env, input=input, timeout=timeout)
                return Proc(proc.returncode)
            proc = subprocess.run(argv, env=env, input=input, capture_output=True, text=True,
                                  timeout=timeout)
            return Proc(proc.returncode, proc.stdout, proc.stderr)
        except subprocess.TimeoutExpired:
            return Proc(124, "", f"timeout after {timeout}s")

    def mutate(self, name, *args, env=None, input=None, ignore_failure=False):
        """Run a command that changes the system; under --check only print it."""
        if self.check:
            plan(f"{name} {' '.join(shlex.quote(str(a)) for a in args)}".rstrip())
            return Proc(0)
        proc = self.run(name, *args, env=env, input=input)
        if not proc.ok:
            text = (proc.err or proc.out).strip()
            if ignore_failure:
                say(f"warning: {name} failed: {text or 'exit %d' % proc.rc}")
            else:
                raise Fail(f"{name} failed: {text or 'exit %d' % proc.rc}")
        return proc

    def interactive(self, name, *args):
        """Run an interactive command with inherited stdio (e.g. passwd)."""
        if self.check:
            plan(f"{name} {' '.join(shlex.quote(str(a)) for a in args)}".rstrip())
            return Proc(0)
        return self.run(name, *args, capture=False)


# --------------------------------------------------------------------------
# input helpers


def _read(prompt, secret=False):
    try:
        return getpass.getpass(prompt) if secret else input(prompt)
    except EOFError:
        raise Fail("interactive input required but stdin is closed; use --yes with flags", 2)


def ask(runner, prompt, default=None, required=True, secret=False):
    if runner.yes:
        if default is not None:
            return default
        if not required:
            return None
        raise Fail(f"--yes was given but '{prompt}' has no default; pass the matching flag", 2)
    while True:
        text = f"{prompt} [{default}]: " if default is not None else f"{prompt}: "
        value = _read(text, secret).strip()
        if value:
            return value
        if default is not None:
            return default
        if not required:
            return None
        say("a value is required")


def confirm(runner, prompt, default=False):
    if runner.yes:
        return default
    suffix = " [Y/n]: " if default else " [y/N]: "
    while True:
        answer = _read(prompt + suffix).strip().lower()
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        say("please answer y or n")


def confirm_action(runner, prompt):
    """A destructive action: --yes means yes, otherwise ask (default no)."""
    if runner.yes:
        return True
    return confirm(runner, prompt, default=False)


def wait_enter(runner, prompt):
    if runner.yes or runner.check:
        return
    _read(prompt + " ")


def ask_choice(runner, prompt, choices, default):
    if runner.yes:
        return default
    while True:
        value = ask(runner, f"{prompt} ({'/'.join(choices)})", default=default)
        if value in choices:
            return value
        say("choose one of: " + ", ".join(choices))


# --------------------------------------------------------------------------
# OS detection


def detect_os(runner):
    path = runner.target("/etc/os-release")
    info = {"id": "", "id_like": "", "version": "", "family": None, "pkg_mgr": None}
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return info
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip().strip('"').strip("'")
        if key == "ID":
            info["id"] = value.lower()
        elif key == "ID_LIKE":
            info["id_like"] = value.lower()
        elif key == "VERSION_ID":
            info["version"] = value
    tokens = set((info["id"] + " " + info["id_like"]).split())
    if tokens & {"debian", "ubuntu"} or any(t.startswith("debian") for t in tokens):
        info["family"] = "debian"
        info["pkg_mgr"] = "apt-get"
    elif tokens & {"rocky", "rhel", "almalinux", "centos", "fedora"}:
        info["family"] = "rocky"
        info["pkg_mgr"] = "dnf"
    return info


def package_manager(runner):
    info = runner.os_info or detect_os(runner)
    manager = info.get("pkg_mgr")
    if not manager:
        raise Fail("cannot detect the OS package manager from /etc/os-release")
    return manager


def install_packages(runner, packages, reason):
    manager = package_manager(runner)
    say(f"{reason}; installing with {manager}: {' '.join(packages)}")
    runner.mutate(manager, "-y", "install", *packages)


# --------------------------------------------------------------------------
# package / file helpers


def package_version():
    override = os.environ.get("AI_DEPLOY_TARGET_VERSION")
    if override:
        return override
    path = Path(__file__).resolve().parent / "VERSION"
    try:
        text = path.read_text(encoding="utf-8").strip()
    except OSError:
        return FALLBACK_VERSION
    return text if re.fullmatch(r"[0-9A-Za-z.+_-]{1,32}", text) else FALLBACK_VERSION


def ensure_dir(runner, path, mode=0o755, owner=None):
    if runner.check:
        plan(f"mkdir -p {path} (mode {mode:o}{', owner ' + owner if owner else ''})")
        return
    os.makedirs(path, exist_ok=True)
    try:
        os.chmod(path, mode)
    except OSError:
        pass
    if owner:
        runner.mutate("chown", owner, path)


def write_file(runner, path, content, mode, owner=None):
    """Atomic, idempotent write; under --check only print the plan. Returns True if changed."""
    data = content.encode("utf-8") if isinstance(content, str) else bytes(content)
    if runner.check:
        plan(f"write {path} (mode {mode:o}, {len(data)} bytes)")
        return False
    parent = os.path.dirname(path) or "."
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, f".{os.path.basename(path)}.tmp.{os.getpid()}")
    with open(tmp, "wb") as handle:
        handle.write(data)
    os.chmod(tmp, mode)
    changed = True
    try:
        if os.path.exists(path):
            with open(path, "rb") as handle:
                if handle.read() == data:
                    changed = False
    except OSError:
        changed = True
    if changed:
        os.replace(tmp, path)
        say(f"wrote: {path} (mode {mode:o})")
    else:
        os.unlink(tmp)
        say(f"unchanged: {path}")
    if owner:
        runner.mutate("chown", owner, path)
    return changed


def read_file(path, default=None):
    try:
        return Path(path).read_text(encoding="utf-8")
    except OSError:
        return default


def remove_file(runner, path):
    if runner.check:
        plan(f"rm -f {path}")
        return
    try:
        os.unlink(path)
        say(f"removed: {path}")
    except FileNotFoundError:
        pass


def remove_tree(runner, path):
    if runner.check:
        plan(f"rm -rf {path}")
        return
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path, ignore_errors=True)
        say(f"removed: {path}")


def install_source(runner, src, dest, mode, owner="root:root"):
    src = Path(src)
    if not src.exists():
        if runner.test_mode:
            say(f"warning: {src.name} is not next to the tool; skipping {dest} in test mode")
            return
        raise Fail(f"package file {src} is missing (incomplete ai-deploy-target package)")
    write_file(runner, dest, src.read_bytes(), mode, owner=owner)


