# public keys


def validate_public_key(runner, line):
    """Return (type, blob) for a single, plain OpenSSH public-key line."""
    line = (line or "").strip()
    if not line:
        raise Fail("empty public key")
    if "\n" in line or "\r" in line:
        raise Fail("a public key must be a single line")
    parts = line.split()
    first = parts[0] if parts else ""
    if '"' in line or "'" in line or "=" in first or "," in first:
        raise Fail("public key must be a plain line without options, quotes or commas")
    if len(parts) < 2:
        raise Fail("not an OpenSSH public key line")
    key_type, blob = parts[0], parts[1]
    if key_type not in KEY_TYPES:
        raise Fail(f"unsupported key type {key_type!r} (use ssh-ed25519)")
    if not re.fullmatch(r"[A-Za-z0-9+/]+={0,3}", blob):
        raise Fail("public key body is not valid base64")
    handle, tmp = tempfile.mkstemp(prefix="ai-deploy-key.", suffix=".pub")
    try:
        os.write(handle, (line + "\n").encode("utf-8"))
    finally:
        os.close(handle)
    try:
        proc = runner.run("ssh-keygen", "-lf", tmp)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    if not proc.ok:
        raise Fail("ssh-keygen rejected the public key")
    bits = 0
    match = re.match(r"^(\d+)\s+", proc.out.strip())
    if match:
        bits = int(match.group(1))
    if key_type == "ssh-rsa" and bits and bits < 3072:
        raise Fail(f"RSA key is only {bits} bits; use at least 3072 (or ssh-ed25519)")
    if key_type != "ssh-ed25519":
        say(f"warning: {key_type} accepted, but ssh-ed25519 is preferred")
    return key_type, blob


def validate_host_key_line(runner, line):
    handle, tmp = tempfile.mkstemp(prefix="ai-deploy-hostkey.")
    try:
        os.write(handle, (line.strip() + "\n").encode("utf-8"))
        os.close(handle)
        proc = runner.run("ssh-keygen", "-lf", tmp)
        if not proc.ok:
            raise Fail("ssh-keygen rejected the host key line")
        say("host key fingerprint: " + proc.out.strip())
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def deploy_authorized_keys_path(runner):
    return runner.target(DEPLOY_HOME) + "/.ssh/authorized_keys"


def gateway_command(runner):
    return runner.target(GATEWAY_PATH)


def managed_authorized_keys_line(runner, key_type, blob):
    return f'restrict,command="{gateway_command(runner)}" {key_type} {blob} {MANAGED_COMMENT}'


def existing_managed_keys(runner):
    content = read_file(deploy_authorized_keys_path(runner), "") or ""
    prefix = 'restrict,command="' + gateway_command(runner) + '"'
    return [line.strip() for line in content.splitlines() if line.strip().startswith(prefix)]


# --------------------------------------------------------------------------
# gateway validation of apps.json


def gateway_module(runner):
    if runner._gateway is not None:
        return runner._gateway
    if runner.test_mode:
        path = Path(__file__).resolve().parent / "gateway.py"
    else:
        installed = Path(runner.target(GATEWAY_PATH))
        path = installed if installed.exists() else Path(__file__).resolve().parent / "gateway.py"
    if not path.exists():
        raise Fail(f"cannot validate apps.json: gateway not found at {path}")
    # The installed gateway has no .py suffix, so name the source loader explicitly.
    loader = importlib.machinery.SourceFileLoader("ai_deploy_gateway_loader", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    previous_bytecode = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        spec.loader.exec_module(module)
    finally:
        sys.dont_write_bytecode = previous_bytecode
    runner._gateway = module
    return module


def validate_gateway(runner, config_path):
    module = gateway_module(runner)
    previous = os.environ.get("AI_DEPLOY_CONFIG")
    os.environ["AI_DEPLOY_CONFIG"] = config_path
    try:
        module.load_apps()
    except Exception as exc:  # noqa: BLE001 - surface the loader's message
        detail = getattr(exc, "detail", None) or str(exc)
        raise Fail(f"apps.json rejected by the gateway: {detail}")
    finally:
        if previous is None:
            os.environ.pop("AI_DEPLOY_CONFIG", None)
        else:
            os.environ["AI_DEPLOY_CONFIG"] = previous


def serialize_document(document):
    return json.dumps(document, indent=2, ensure_ascii=False) + "\n"


def validate_document(runner, document):
    """Validate a whole apps.json document without touching the target state."""
    data = serialize_document(document)
    if runner.check:
        directory = tempfile.gettempdir()
    else:
        directory = os.path.dirname(runner.target(CONFIG_PATH))
        os.makedirs(directory, exist_ok=True)
    handle, tmp = tempfile.mkstemp(prefix=".ai-deploy-apps.json.", dir=directory)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(data)
        os.chmod(tmp, 0o644)
        validate_gateway(runner, tmp)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def install_document(runner, document):
    path = runner.target(CONFIG_PATH)
    ensure_dir(runner, os.path.dirname(path), 0o755)
    if runner.check:
        plan(f"write {path} (mode 644)")
        return
    data = serialize_document(document)
    directory = os.path.dirname(path)
    handle, tmp = tempfile.mkstemp(prefix=".apps.json.", dir=directory)
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        stream.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    say(f"wrote: {path}")


def load_document(runner):
    content = read_file(runner.target(CONFIG_PATH))
    if content is None:
        return None
    try:
        document = json.loads(content)
    except ValueError as exc:
        raise Fail(f"{runner.target(CONFIG_PATH)} is not valid JSON: {exc}")
    if not isinstance(document, dict):
        raise Fail(f"{runner.target(CONFIG_PATH)} must contain a JSON object")
    document.setdefault("schema", APP_SCHEMA)
    if not isinstance(document.get("apps"), dict):
        document["apps"] = {}
    return document


def empty_document():
    return {"schema": APP_SCHEMA, "apps": {}}


# --------------------------------------------------------------------------
# sudoers / units / selinux


# Must be exactly the path the gateway executes (gateway.py restart_unit), or sudo refuses the rule.
GATEWAY_SYSTEMCTL = "/usr/bin/systemctl"


def sudoers_systemctl_path(runner):
    if runner.test_mode:
        return runner.require("systemctl", ["systemd"])
    if not os.path.exists(GATEWAY_SYSTEMCTL):
        raise Fail(f"{GATEWAY_SYSTEMCTL} is missing; the gateway restarts units with exactly that path")
    return GATEWAY_SYSTEMCTL


def regenerate_sudoers(runner, document):
    rules = []
    for name in sorted(document.get("apps", {})):
        app = document["apps"][name]
        kind = app.get("kind", "service")
        if kind == "service":
            unit = app.get("unit")
            if not unit:
                continue
            rules.append(
                f"{DEPLOY_USER} ALL=(root) NOPASSWD: {sudoers_systemctl_path(runner)} "
                f"restart {unit}")
        elif kind == "compose":
            rules.append(
                f"{DEPLOY_USER} ALL=(root) NOPASSWD: "
                f"{runner.target(COMPOSE_UP_PATH)} {name}")
    path = runner.target(SUDOERS_PATH)
    if not rules:
        if os.path.exists(path) or runner.check:
            remove_file(runner, path)
            say("no restartable units or compose apps; sudoers left without ai-deploy rules")
        return
    header = (f"# Managed by {PROG}. Generated from {runner.target(CONFIG_PATH)} — "
              f"do not edit by hand.\n")
    content = header + "\n".join(rules) + "\n"
    if runner.check:
        plan(f"write {path} (mode 440) with:")
        for rule in rules:
            say("    " + rule)
        return
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    handle, tmp = tempfile.mkstemp(prefix=".ai-deploy.sudoers.", dir=directory)
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        stream.write(content)
    os.chmod(tmp, 0o440)
    visudo = runner.which("visudo")
    if visudo is None:
        os.unlink(tmp)
        raise Fail("visudo is not available" + runner.install_hint(("sudo",)))
    proc = runner.run("visudo", "-cf", tmp)
    if not proc.ok:
        os.unlink(tmp)
        detail = (proc.err or proc.out).strip()
        raise Fail(f"visudo rejected the generated sudoers file: {detail or 'exit %d' % proc.rc}")
    os.replace(tmp, path)
    os.chmod(path, 0o440)
    say(f"wrote: {path} (mode 440)")
    for rule in rules:
        say("    " + rule)


def nologin_home(user):
    return "/nonexistent"


def ensure_app_user(runner, name):
    user = "app-" + name
    if user_exists(runner, user):
        return user
    shell = nologin_path(runner)
    runner.mutate("useradd", "--system", "--no-create-home", "--home-dir", nologin_home(user),
                  "--shell", shell, user)
    return user


def app_env_path(runner, name):
